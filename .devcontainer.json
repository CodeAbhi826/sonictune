// .devcontainer.json
{
  "name": "SonicTune Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "uid": "1000",
      "gid": "1000"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "runArgs": [
    "--privileged", // Required for X11 forwarding
    "--env=DISPLAY=:1", // Forward X11 display
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix" // Share X11 socket
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash -c 'pkill -f \"Xvfb :1\" 2>/dev/null; Xvfb :1 -screen 0 1024x768x24 >/dev/null 2>&1 &'",
  "forwardPorts": [8000], // For web-based UI testing
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}